# Hostinger MySQL connection string
# Example: mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

ADMIN_EMAIL="admin@cocktaillo.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Cocktaillo POS integration
COCKTAILLO_POS_URL="https://indigo-ape-952022.hostingersite.com"
COCKTAILLO_WEBSITE_ORDER_KEY="use-the-exact-same-long-random-key-on-the-pos"

# Optional automatic WhatsApp order notification via WhatsApp Cloud API.
# WHATSAPP_ORDER_RECIPIENT should be the separate admin/owner number that receives notifications.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ORDER_RECIPIENT=""
WHATSAPP_GRAPH_VERSION="v23.0"
# Optional approved template with one body text variable containing the full order summary.
WHATSAPP_ORDER_TEMPLATE_NAME=""
WHATSAPP_ORDER_TEMPLATE_LANG="en_US"
